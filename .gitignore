# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# vite
.vite/
.cache/

# vitest
coverage/

# env
.env
.env.*
!.env.example
/deploy/env

# local data (auth db, world snapshots) — runtime state at the repo
# root only. Anchored with a leading slash so it does NOT swallow
# in-tree directories named "data" (e.g. packages/*/src/data, where
# generated catalogs and curated content live).
/data/
*.db
*.db-journal
*.db-shm
*.db-wal
auth.secret

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editors / OS
.DS_Store
.idea/
*.swp

reference/

# adventure authoring working dirs and built bundles — content is
# personal / per-campaign and ships out-of-band as .advt.zip imports.
/adventures/

# BEGIN swamp managed section - DO NOT EDIT

# Runtime data (not needed in version control)
.swamp/

# Local extension sources (developer-specific, not shared)
.swamp-sources.yaml

# Claude Code configuration (managed by swamp)
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
# END swamp managed section
