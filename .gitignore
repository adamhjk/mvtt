# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# vite
.vite/
.cache/

# vitest
coverage/

# env
.env
.env.*
!.env.example

# local data (auth db, world snapshots) — runtime state at the repo
# root only. Anchored with a leading slash so it does NOT swallow
# in-tree directories named "data" (e.g. packages/*/src/data, where
# generated catalogs and curated content live).
/data/
*.db
*.db-journal
*.db-shm
*.db-wal
auth.secret

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editors / OS
.DS_Store
.idea/
*.swp

reference/
