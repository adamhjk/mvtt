# mvtt server env. Copy to /srv/mvtt/deploy/env and edit. Owned by
# mvtt:mvtt with mode 0600 (the auth secret is sensitive).

# Port the Node server binds. Caddy proxies to this.
PORT=3001

# Public URL. Better-auth uses this for cookie domain + redirect URLs,
# and the substrate uses it as the canonical origin in WS upgrade
# checks.
BETTER_AUTH_URL=https://mvtt.example.com

# Comma-separated origins better-auth will accept. The public URL must
# be in this list. Add additional origins (staging, alt domains) as
# needed.
TRUSTED_ORIGINS=https://mvtt.example.com

# Long-lived signing secret for sessions. If unset, the server
# generates one and writes it to data/auth.secret on first boot.
# Override here only if you want to manage the secret out-of-band.
# BETTER_AUTH_SECRET=
