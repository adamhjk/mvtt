{
  "name": "mvtt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "pnpm --filter @vtt/server dev",
    "dev:client": "pnpm --filter @vtt/client dev",
    "dev": "pnpm -r --parallel --filter @vtt/server --filter @vtt/client dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "license:apply": "node scripts/apply-license-header.mjs",
    "reset": "rm -rf data && echo 'cleared local data — next start will prompt to create the Game Master'"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "canvas": "^3.2.3",
    "jsdom": "^29.1.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.6.3",
    "vite-plugin-solid": "^2.10.2",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.33.2",
  "volta": {
    "node": "24.15.0"
  },
  "engines": {
    "node": ">=20"
  }
}
