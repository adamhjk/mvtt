{
  "name": "@vtt/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DEV_PROXY_URL=http://localhost:5173 node --import tsx src/main.ts --watch",
    "start": "node --import tsx src/main.ts",
    "smoke": "node --import tsx src/smoke.ts && node --import tsx src/scene-smoke.ts && node --import tsx src/characters-smoke.ts && node --import tsx src/books-smoke.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@vtt/auth": "workspace:*",
    "@vtt/books": "workspace:*",
    "@vtt/characters": "workspace:*",
    "@vtt/comms": "workspace:*",
    "@vtt/dice-tray": "workspace:*",
    "@vtt/identity": "workspace:*",
    "@vtt/pdf-book": "workspace:*",
    "@vtt/permissions": "workspace:*",
    "@vtt/persistence-sqlite": "workspace:*",
    "@vtt/ping": "workspace:*",
    "@vtt/resolution": "workspace:*",
    "@vtt/scene": "workspace:*",
    "@vtt/shell-default": "workspace:*",
    "@vtt/shell-workbench": "workspace:*",
    "@vtt/substrate": "workspace:*",
    "better-auth": "^1.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2"
  },
  "volta": {
    "node": "22.22.2"
  }
}
